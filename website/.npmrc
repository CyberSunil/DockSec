# The public npm registry, pinned for this project.
#
# Without this, npm inherits whatever registry the machine is configured for.
# A corporate Artifactory mirror is unreachable from CI and from a contributor
# outside that network, and the failure mode is a confusing ENOTFOUND rather
# than anything that names the cause.
#
# This is a public OWASP project: its dependencies must resolve for anyone.
registry=https://registry.npmjs.org/
